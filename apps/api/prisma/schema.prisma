generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductSaleType {
  IN_STOCK
  PREORDER
}

enum FileStatus {
  PENDING
  READY
  QUARANTINED
  DELETED
}

enum MerchantApplicationStatus {
  DRAFT
  SUBMITTED
  NEEDS_CHANGES
  APPROVED
  REJECTED
  WITHDRAWN
}

enum MerchantMemberRole {
  OWNER
  STAFF
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum InventoryLedgerType {
  INITIAL_STOCK
  ADJUSTMENT
  RESERVATION_CREATED
  RESERVATION_COMMITTED
  RESERVATION_RELEASED
}

enum InventoryReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum CouponType {
  FIXED
  PERCENTAGE
}

enum CouponStatus {
  ACTIVE
  PAUSED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PARTIALLY_SHIPPED
  SHIPPED
  COMPLETED
  CANCELLED
  AFTER_SALE
  CLOSED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum JobType {
  CLOSE_EXPIRED_ORDER
  AUTO_CONFIRM_RECEIPT
}

enum ShipmentStatus {
  SHIPPED
  DELIVERED
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY
  COMPLETED
  DEAD_LETTER
}

enum AfterSaleType {
  REFUND_ONLY
  RETURN_REFUND
}

enum AfterSaleStatus {
  REQUESTED
  APPROVED
  REJECTED
  AWAITING_RETURN
  RETURNED
  REFUND_PROCESSING
  COMPLETED
  CANCELLED
}

model FileAsset {
  id          String     @id @default(cuid())
  ownerId     String
  purpose     String     @db.VarChar(80)
  objectKey   String     @unique @db.VarChar(255)
  fileName    String     @db.VarChar(255)
  mimeType    String     @db.VarChar(120)
  sizeBytes   Int
  status      FileStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId, purpose, status])
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique @db.VarChar(80)
  displayName  String     @db.VarChar(120)
  passwordHash String     @db.VarChar(255)
  isActive     Boolean    @default(true)
  roles        UserRole[]
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  cart         Cart?
  couponClaims CouponClaim[]
  couponRedemptions CouponRedemption[]
  checkoutQuotes CheckoutQuote[]
  addresses Address[]
  orders Order[]
  merchantApplications MerchantApplication[] @relation("MerchantApplicant")
  reviewedMerchantApplications MerchantApplication[] @relation("MerchantReviewer")
  applicationTimeline MerchantApplicationTimeline[]
  ownedMerchant Merchant? @relation("MerchantOwner")
  merchantMemberships MerchantMember[]
  receivedStaffInvitations StaffInvitation[] @relation("StaffInvitee")
  sentStaffInvitations StaffInvitation[] @relation("StaffInviter")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  recipient   String   @db.VarChar(120)
  phone       String   @db.VarChar(40)
  country     String   @db.VarChar(80)
  province    String   @db.VarChar(80)
  city        String   @db.VarChar(80)
  district    String   @db.VarChar(80)
  addressLine String   @db.VarChar(240)
  postalCode  String?  @db.VarChar(20)
  isDefault   Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isDefault, updatedAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @db.VarChar(255)
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?   @db.VarChar(255)
  ipAddress        String?   @db.VarChar(64)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(100)
  targetType String?  @db.VarChar(80)
  targetId   String?  @db.VarChar(191)
  ipAddress  String?  @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      String   @db.VarChar(50)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model Merchant {
  id        String         @id @default(cuid())
  ownerId   String?        @unique
  name      String         @db.VarChar(160)
  status    MerchantStatus @default(ACTIVE)
  store     Store?
  owner     User?          @relation("MerchantOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   MerchantMember[]
  staffInvitations StaffInvitation[]
  merchantOrders MerchantOrder[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model MerchantMember {
  id         String             @id @default(cuid())
  merchantId String
  userId     String
  role       MerchantMemberRole @default(STAFF)
  routePermissions Json?
  buttonPermissions Json?
  merchant   Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([merchantId, userId])
  @@index([userId])
}

model StaffInvitation {
  id         String                @id @default(cuid())
  merchantId String
  inviteeId  String
  invitedById String
  role       MerchantMemberRole    @default(STAFF)
  status     StaffInvitationStatus @default(PENDING)
  expiresAt  DateTime
  merchant   Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invitee    User                  @relation("StaffInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  invitedBy  User                  @relation("StaffInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([inviteeId, status, expiresAt])
  @@index([merchantId, status])
}

model MerchantApplication {
  id                    String                    @id @default(cuid())
  applicantId           String
  reviewerId            String?
  status                MerchantApplicationStatus @default(DRAFT)
  companyName           String                    @db.VarChar(160)
  contactName           String                    @db.VarChar(120)
  contactPhone          String                    @db.VarChar(40)
  contactEmail          String                    @db.VarChar(160)
  businessLicenseNumber String                    @db.VarChar(100)
  qualificationFileIds  Json
  agreementAccepted     Boolean                   @default(false)
  reviewComment         String?                   @db.VarChar(1000)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  applicant             User                      @relation("MerchantApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  reviewer              User?                     @relation("MerchantReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  timeline              MerchantApplicationTimeline[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([applicantId, createdAt])
  @@index([status, submittedAt])
}

model MerchantApplicationTimeline {
  id            String                    @id @default(cuid())
  applicationId String
  actorId       String
  fromStatus    MerchantApplicationStatus?
  toStatus      MerchantApplicationStatus
  comment       String?                   @db.VarChar(1000)
  application   MerchantApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User                      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt     DateTime                  @default(now())

  @@index([applicationId, createdAt])
}

model Store {
  id         String    @id @default(cuid())
  merchantId String    @unique
  name       String    @db.VarChar(160)
  slug       String    @unique @db.VarChar(120)
  isOpen     Boolean   @default(true)
  logoFileId String?
  bannerFileId String?
  description String?  @db.Text
  customerServiceEmail String? @db.VarChar(160)
  customerServicePhone String? @db.VarChar(40)
  returnAddress Json?
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  products   Product[]
  coupons    Coupon[]
  merchantOrders MerchantOrder[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Category {
  id                 String              @id @default(cuid())
  parentId           String?
  slug               String              @unique @db.VarChar(120)
  nameZhCn           String              @db.VarChar(160)
  nameEnUs           String?             @db.VarChar(160)
  descriptionZhCn    String?             @db.VarChar(500)
  descriptionEnUs    String?             @db.VarChar(500)
  isActive           Boolean             @default(true)
  sortOrder          Int                 @default(0)
  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[]          @relation("CategoryTree")
  products           Product[]
  attributeTemplates AttributeTemplate[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([parentId, sortOrder])
  @@index([isActive, sortOrder])
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique @db.VarChar(120)
  nameZhCn    String    @db.VarChar(160)
  nameEnUs    String?   @db.VarChar(160)
  descriptionZhCn String? @db.VarChar(500)
  descriptionEnUs String? @db.VarChar(500)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Franchise {
  id          String      @id @default(cuid())
  slug        String      @unique @db.VarChar(120)
  nameZhCn    String      @db.VarChar(160)
  nameEnUs    String?     @db.VarChar(160)
  descriptionZhCn String? @db.VarChar(500)
  descriptionEnUs String? @db.VarChar(500)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  characters Character[]
  products    Product[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isActive, sortOrder])
}

model Character {
  id          String    @id @default(cuid())
  franchiseId String
  slug        String    @unique @db.VarChar(120)
  nameZhCn    String    @db.VarChar(160)
  nameEnUs    String?   @db.VarChar(160)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Restrict)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([franchiseId, isActive, sortOrder])
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique @db.VarChar(120)
  nameZhCn  String    @db.VarChar(100)
  nameEnUs  String?   @db.VarChar(100)
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model AttributeTemplate {
  id          String     @id @default(cuid())
  categoryId  String?
  code        String     @unique @db.VarChar(80)
  nameZhCn    String     @db.VarChar(120)
  nameEnUs    String?    @db.VarChar(120)
  inputType   String     @db.VarChar(30)
  options     Json?
  isRequired  Boolean    @default(false)
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([categoryId, isActive, sortOrder])
}

model Product {
  id         String        @id @default(cuid())
  storeId    String
  categoryId String?
  brandId    String?
  franchiseId String?
  characterId String?
  titleZhCn  String        @db.VarChar(200)
  titleEnUs  String?       @db.VarChar(200)
  descriptionZhCn String?  @db.Text
  descriptionEnUs String?  @db.Text
  material   String?       @db.VarChar(160)
  scale      String?       @db.VarChar(80)
  manufacturer String?     @db.VarChar(160)
  copyrightNotice String?  @db.VarChar(500)
  saleType   ProductSaleType @default(IN_STOCK)
  presaleNotice String?      @db.Text
  shippingWindowStart DateTime?
  shippingWindowEnd DateTime?
  afterSalesSummary String?  @db.VarChar(1000)
  salesCount Int             @default(0)
  status     ProductStatus @default(DRAFT)
  store      Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand      Brand?        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  franchise  Franchise?    @relation(fields: [franchiseId], references: [id], onDelete: Restrict)
  character  Character?    @relation(fields: [characterId], references: [id], onDelete: Restrict)
  tags       Tag[]
  skus       Sku[]
  media      ProductMedia[]
  descriptionAssets ProductDescriptionAsset[]
  reviewEvents ProductReviewEvent[]
  couponScopes CouponProduct[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([storeId, status])
  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([franchiseId, status])
  @@index([characterId, status])
  @@index([status, saleType, updatedAt])
}

model CheckoutQuote {
  id               String   @id @db.Char(36)
  userId           String
  version          String   @db.VarChar(20)
  signature        String   @db.VarChar(100)
  currency         String   @default("CNY") @db.Char(3)
  addressSnapshot  Json
  couponCode       String?  @db.VarChar(40)
  originalAmount   Decimal  @db.Decimal(10, 2)
  shippingAmount   Decimal  @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal  @default(0) @db.Decimal(10, 2)
  payableAmount    Decimal  @db.Decimal(10, 2)
  snapshot         Json
  expiresAt        DateTime
  consumedAt       DateTime?
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order            Order?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model Order {
  id               String          @id @db.Char(36)
  orderNumber      String          @unique @db.VarChar(32)
  userId           String
  quoteId          String          @unique @db.Char(36)
  idempotencyKey   String          @db.VarChar(100)
  requestHash      String          @db.Char(64)
  status           OrderStatus     @default(PENDING_PAYMENT)
  currency         String          @default("CNY") @db.Char(3)
  originalAmount   Decimal         @db.Decimal(10, 2)
  shippingAmount   Decimal         @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal         @default(0) @db.Decimal(10, 2)
  payableAmount    Decimal         @db.Decimal(10, 2)
  addressSnapshot  Json
  couponCode       String?         @db.VarChar(40)
  expiresAt        DateTime
  paidAt           DateTime?
  cancelledAt      DateTime?
  completedAt      DateTime?
  buyer            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  quote            CheckoutQuote   @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  merchantOrders   MerchantOrder[]
  items            OrderItem[]
  events           OrderEvent[]
  paymentIntent    PaymentIntent?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model MerchantOrder {
  id               String       @id @default(cuid())
  orderId          String       @db.Char(36)
  merchantId       String
  storeId          String
  status           OrderStatus  @default(PENDING_PAYMENT)
  currency         String       @default("CNY") @db.Char(3)
  originalAmount   Decimal      @db.Decimal(10, 2)
  shippingAmount   Decimal      @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal      @default(0) @db.Decimal(10, 2)
  payableAmount    Decimal      @db.Decimal(10, 2)
  merchantNote     String?      @db.VarChar(1000)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  merchant         Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  store            Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  shipments        Shipment[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([orderId, storeId])
  @@index([merchantId, status, createdAt])
}

model OrderItem {
  id               String        @id @db.Char(36)
  orderId          String        @db.Char(36)
  merchantOrderId  String
  storeId          String
  productId        String
  skuId            String
  productTitle     String        @db.VarChar(200)
  skuName          String        @db.VarChar(160)
  coverFileId      String?
  quantity         Int
  currency         String        @default("CNY") @db.Char(3)
  unitPrice        Decimal       @db.Decimal(10, 2)
  originalAmount   Decimal       @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  payableAmount    Decimal       @db.Decimal(10, 2)
  pricingSnapshot  Json
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  merchantOrder    MerchantOrder  @relation(fields: [merchantOrderId], references: [id], onDelete: Restrict)
  shipmentItems    ShipmentItem[]
  createdAt        DateTime       @default(now())

  @@index([orderId])
  @@index([merchantOrderId])
  @@index([skuId])
}

model Shipment {
  id              String         @id @default(cuid())
  merchantOrderId String
  carrier         String         @db.VarChar(40)
  trackingNumber  String         @db.VarChar(80)
  status          ShipmentStatus @default(SHIPPED)
  note            String?        @db.VarChar(500)
  shippedAt       DateTime       @default(now())
  deliveredAt     DateTime?
  createdBy       String?
  merchantOrder   MerchantOrder  @relation(fields: [merchantOrderId], references: [id], onDelete: Restrict)
  items           ShipmentItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([merchantOrderId, carrier, trackingNumber])
  @@index([merchantOrderId, createdAt])
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  orderItemId String   @db.Char(36)
  quantity    Int
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
}

model OrderEvent {
  id          String       @id @default(cuid())
  orderId     String       @db.Char(36)
  actorId     String?
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  type        String       @db.VarChar(60)
  metadata    Json?
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

model PaymentIntent {
  id                 String        @id @default(cuid())
  orderId            String        @unique @db.Char(36)
  status             PaymentStatus @default(PENDING)
  provider           String        @default("SANDBOX") @db.VarChar(40)
  providerPaymentId  String?       @unique @db.VarChar(100)
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("CNY") @db.Char(3)
  expiresAt          DateTime
  paidAt             DateTime?
  closedAt           DateTime?
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events             PaymentEvent[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, expiresAt])
}

model PaymentEvent {
  id                 String         @id @default(cuid())
  paymentIntentId    String?
  provider           String         @db.VarChar(40)
  providerEventId    String         @unique @db.VarChar(120)
  eventType          String         @db.VarChar(60)
  rawBody            String         @db.LongText
  eventData          Json
  signatureValid     Boolean        @default(false)
  ignored            Boolean        @default(false)
  errorCode          String?        @db.VarChar(80)
  processedAt        DateTime?
  paymentIntent      PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  createdAt          DateTime       @default(now())

  @@index([paymentIntentId, createdAt])
  @@index([processedAt, createdAt])
}

model OrderExportTask {
  id            String   @id @default(cuid())
  requesterId   String
  merchantId    String?
  status        String   @default("PENDING") @db.VarChar(20)
  filters       Json
  downloadName  String?  @db.VarChar(255)
  resultCsv     String?  @db.LongText
  errorMessage  String?  @db.VarChar(1000)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([requesterId, createdAt])
  @@index([merchantId, status])
}

model Job {
  id            String    @id @default(cuid())
  type          JobType
  uniqueKey     String    @unique @db.VarChar(191)
  payload       Json
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  runAt         DateTime
  lockedAt      DateTime?
  lockedBy      String?   @db.VarChar(100)
  lastError     String?   @db.VarChar(1000)
  deadLetterAt  DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, runAt])
  @@index([deadLetterAt, createdAt])
}

model AfterSale {
  id                 String         @id @default(cuid())
  afterSaleNumber    String         @unique @db.VarChar(32)
  userId             String
  orderId            String         @db.Char(36)
  orderItemId        String         @db.Char(36)
  merchantOrderId    String
  merchantId         String
  storeId            String
  type               AfterSaleType
  status             AfterSaleStatus @default(REQUESTED)
  reason             String         @db.VarChar(200)
  description        String         @db.VarChar(2000)
  refundAmount       Decimal        @db.Decimal(10, 2)
  evidence           Json
  returnCarrier      String?        @db.VarChar(40)
  returnTrackingNumber String?      @db.VarChar(80)
  returnShippedAt    DateTime?
  merchantNote       String?        @db.VarChar(1000)
  platformNote       String?        @db.VarChar(1000)
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([userId, orderItemId])
  @@index([userId, orderItemId])
  @@index([userId, createdAt])
  @@index([merchantId, status, createdAt])
  @@index([orderId])
  @@index([orderItemId])
}

model Coupon {
  id             String       @id @default(cuid())
  storeId        String
  code           String       @unique @db.VarChar(40)
  name           String       @db.VarChar(160)
  type           CouponType
  value          Decimal      @db.Decimal(10, 2)
  minimumAmount  Decimal      @default(0) @db.Decimal(10, 2)
  startsAt       DateTime
  endsAt         DateTime
  status         CouponStatus @default(ACTIVE)
  totalLimit     Int
  perUserLimit   Int
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  products       CouponProduct[]
  claims         CouponClaim[]
  redemptions    CouponRedemption[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([storeId, status, endsAt])
}

model CouponProduct {
  couponId String
  productId String
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponClaim {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  redemption CouponRedemption?
  claimedAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([userId, claimedAt])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  claimId        String?  @unique
  couponId       String
  userId         String
  orderId        String   @unique @db.VarChar(191)
  originalAmount Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @db.Decimal(10, 2)
  ruleSnapshot   Json
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  claim          CouponClaim? @relation(fields: [claimId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  usedAt         DateTime @default(now())

  @@index([couponId, usedAt])
  @@index([userId, usedAt])
}

model ProductReviewEvent {
  id            String        @id @default(cuid())
  productId     String
  actorId       String
  fromStatus    ProductStatus
  toStatus      ProductStatus
  reason        String?       @db.VarChar(1000)
  fieldFeedback Json?
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@index([productId, createdAt])
  @@index([toStatus, createdAt])
}

model Sku {
  id          String     @id @default(cuid())
  productId   String
  code        String     @unique @db.VarChar(80)
  nameZhCn    String     @db.VarChar(160)
  nameEnUs    String?    @db.VarChar(160)
  barcode     String?    @db.VarChar(80)
  imageFileId String?
  optionValues Json?
  weightGrams Int?
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?
  priceAmount Decimal    @db.Decimal(10, 2)
  currency    String     @default("CNY") @db.Char(3)
  purchaseLimit Int?
  isActive    Boolean    @default(true)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory   Inventory?
  cartItems   CartItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([productId])
  @@index([barcode])
}

model ProductDescriptionAsset {
  id        String   @id @default(cuid())
  productId String
  fileId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([productId, fileId])
  @@index([fileId])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  guestToken String?    @unique @db.VarChar(64)
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([guestToken])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  skuId     String
  quantity  Int
  selected  Boolean  @default(true)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku       Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, skuId])
  @@index([skuId])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  fileId    String
  kind      String   @default("IMAGE") @db.VarChar(20)
  altZhCn   String?  @db.VarChar(200)
  altEnUs   String?  @db.VarChar(200)
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([productId, fileId])
  @@index([productId, sortOrder])
}

model Inventory {
  id                String                 @id @default(cuid())
  skuId             String                 @unique
  onHand            Int                    @default(0)
  reserved          Int                    @default(0)
  lowStockThreshold Int                    @default(5)
  version           Int                    @default(0)
  sku               Sku                    @relation(fields: [skuId], references: [id], onDelete: Restrict)
  ledgerEntries     InventoryLedgerEntry[]
  reservations      InventoryReservation[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model InventoryLedgerEntry {
  id            String              @id @default(cuid())
  inventoryId   String
  type          InventoryLedgerType
  onHandDelta   Int
  reservedDelta Int
  onHandAfter   Int
  reservedAfter Int
  reason        String              @db.VarChar(500)
  referenceType String?             @db.VarChar(50)
  referenceId   String?             @db.VarChar(191)
  actorId       String?             @db.VarChar(191)
  inventory     Inventory           @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
}

model InventoryReservation {
  id            String                     @id @default(cuid())
  inventoryId   String
  referenceId   String                     @db.VarChar(191)
  quantity      Int
  status        InventoryReservationStatus @default(ACTIVE)
  expiresAt     DateTime
  committedAt   DateTime?
  releasedAt    DateTime?
  releaseReason String?                    @db.VarChar(500)
  inventory     Inventory                  @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@unique([inventoryId, referenceId])
  @@index([status, expiresAt])
}
